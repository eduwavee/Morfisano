# Postgres (Supabase → Project Settings → Database → Connection string)
#
# DATABASE_URL: la connection string del *pooler* en modo transaction (6543).
# Es la que usa la app en runtime. Acordate de agregarle `?pgbouncer=true`.
DATABASE_URL="postgresql://postgres.xxxxxxxx:TU_PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: el pooler en modo session (5432). Solo la usa `prisma migrate`,
# porque pgbouncer en modo transaction no soporta prepared statements.
# Ojo: NO uses la conexión directa `db.<ref>.supabase.co`, que es IPv6 only en
# el plan free y falla desde redes IPv4.
DIRECT_URL="postgresql://postgres.xxxxxxxx:TU_PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Puerto del servidor
PORT=4000

# URL del proyecto de Supabase (Project Settings → Data API).
# El backend baja de acá el JWKS para validar la firma de los access tokens.
# Como Supabase firma con ES256 (clave asimétrica), no hay ningún secreto que
# compartir: el backend solo necesita la clave pública.
SUPABASE_URL="https://xxxxxxxx.supabase.co"

# Escotilla SOLO para desarrollo local: si la descomentás, la API deja de pedir
# token y trata todos los requests como este usuario. Se ignora si NODE_ENV=production.
# DEV_AUTH_USER_ID="demo-user"

# API key de Anthropic, para el análisis de fotos de comida con Claude Vision.
# Sin esta variable, /api/analyze-photo devuelve una estimación mock para poder
# seguir desarrollando el resto de la app sin depender de la IA.
ANTHROPIC_API_KEY=""
